# Copiar a .env (o .env.local) y completar con los valores reales.
# NUNCA commitear .env — ya está en .gitignore.
#
# Estas variables se inyectan en el bundle del cliente en build time (prefijo VITE_
# requerido por Vite). La publishable key de Supabase está diseñada para exponerse
# en el cliente — la seguridad real la da Row Level Security (RLS) en las tablas,
# no el secreto de la key. NUNCA pongas aquí una service_role/secret key.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
